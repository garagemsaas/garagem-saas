# Copie para .env e substitua todos os valores CHANGE_ME. Nunca versionar .env.
DATABASE_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
S3_ACCESS_KEY=garagem-local
S3_SECRET_KEY=CHANGE_ME_AT_LEAST_12_CHARS
S3_BUCKET=garagem-fotos
PUBLIC_BASE_URL=http://localhost:5173
# Origens de navegador autorizadas, separadas por vírgula. Vazio = nenhuma origem cruzada,
# que é o correto em desenvolvimento, onde o frontend passa pelo proxy do Vite.
# Nunca use "*": a aplicação recusa subir com curinga.
CORS_ALLOWED_ORIGINS=
# Validade dos tokens, no formato ISO-8601 de duração. Os padrões abaixo já são os de fábrica.
# Cookie HttpOnly do refresh token. Em desenvolvimento tudo roda na mesma origem por http, e aí
# SameSite=None seria recusado pelo navegador por exigir Secure.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
# Validade do link público de acompanhamento da OS.
PUBLIC_LINK_TTL=P7D
# Bootstrap explícito da primeira oficina (não altera oficina já existente).
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_SLUG=minha-oficina
APP_BOOTSTRAP_NOME=Minha Oficina
APP_BOOTSTRAP_EMAIL=owner@example.com
APP_BOOTSTRAP_SENHA=CHANGE_ME_AT_LEAST_12_CHARS

# Observabilidade: limiar inclusivo de request lento e espera máxima por conexão (ms).
SLOW_REQUEST_MS=1000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Segurança: teto de requisições por origem nas superfícies anônimas (Fase 8 — auditoria).
# O login custa um BCrypt de custo 12 por tentativa: o teto protege senha E CPU ao mesmo tempo.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_WINDOW=PT1M
# Só ligue atrás de um proxy que SOBRESCREVA X-Forwarded-For. Ligado com a porta exposta direto,
# qualquer cliente forja o cabeçalho e escapa do teto.
TRUST_PROXY=false
# Ligue como "framework" junto com TRUST_PROXY=true atrás de proxy TLS: sem isto o Spring não
# se enxerga em HTTPS e nunca emite HSTS. Valores: none (padrão) ou framework.
FORWARD_HEADERS_STRATEGY=none
# Documentação interativa. Deixe false em produção: ela descreve toda a API a quem não autenticou.
API_DOCS_ENABLED=true

# Provisionamento por venda direta, sem cotas comerciais.
# Opcionais: sem eles a empresa nasce com OFICINA e a auditoria registra "bootstrap".
APP_BOOTSTRAP_MODULOS=OFICINA
APP_BOOTSTRAP_OPERADOR=operador-responsavel
