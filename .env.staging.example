# Modelo de ambiente para STAGING. Copie para .env no host de staging e substitua
# todos os CHANGE_ME por valores gerados no próprio servidor.
#
# NUNCA versione o arquivo preenchido. NUNCA reaproveite estes valores em produção.
# NUNCA reaproveite segredos entre ambientes: staging comprometido não pode virar produção
# comprometida.
#
# Procedimento completo em docs/staging.md.

# --- Banco ---------------------------------------------------------------
# Gere com: openssl rand -base64 24
DATABASE_PASSWORD=CHANGE_ME

# --- JWT -----------------------------------------------------------------
# Mínimo de 32 bytes; a aplicação recusa subir com menos.
# Gere com: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
# Validade dos tokens, em duração ISO-8601. Trocar o segredo invalida todos os
# access tokens em circulação na hora.
# Cookie HttpOnly do refresh token. Frontend e API em domínios diferentes: só SameSite=None
# atravessa, e None sem Secure é recusado pelo navegador.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=None
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# --- Armazenamento de fotos (MinIO/S3) -----------------------------------
# O bucket é privado. A API nunca expõe o endpoint do storage ao navegador.
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME_AT_LEAST_12_CHARS
S3_BUCKET=garagem-fotos-staging

# --- Frontend e CORS -----------------------------------------------------
# Origem do frontend de staging, usada para montar o link público do cliente.
PUBLIC_BASE_URL=https://staging.garagem.example
# Origens de navegador autorizadas, separadas por vírgula, com esquema, host e porta.
# Sem caminho, sem barra final, sem curinga: a aplicação recusa subir com "*".
# Deixe vazio se o frontend for servido pelo mesmo domínio da API.
CORS_ALLOWED_ORIGINS=https://staging.garagem.example

# --- Link público de acompanhamento --------------------------------------
PUBLIC_LINK_TTL=P7D

# --- Primeira oficina ----------------------------------------------------
# Deixe false depois da primeira subida bem-sucedida. O bootstrap não altera
# oficina já existente, mas manter ligado é ruído desnecessário.
APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_SLUG=oficina-staging
APP_BOOTSTRAP_NOME=Oficina de Staging
APP_BOOTSTRAP_EMAIL=owner@staging.garagem.example
# Mínimo de 12 caracteres e no máximo 72 bytes. Troque no primeiro acesso.
APP_BOOTSTRAP_SENHA=CHANGE_ME_AT_LEAST_12_CHARS

# Observabilidade: limiar inclusivo de request lento e espera máxima por conexão (ms).
SLOW_REQUEST_MS=1000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# --- Segurança (Fase 8 — auditoria) --------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_WINDOW=PT1M
# Staging fica atrás de proxy TLS: ligue junto com server.forward-headers-strategy=framework,
# senão todo cliente compartilha o IP do proxy e um abusador barra a oficina inteira.
TRUST_PROXY=true
FORWARD_HEADERS_STRATEGY=framework
# Documentação interativa fechada fora de desenvolvimento.
API_DOCS_ENABLED=false

# Provisionamento por venda direta, sem cotas comerciais.
APP_BOOTSTRAP_MODULOS=OFICINA
APP_BOOTSTRAP_OPERADOR=operador-responsavel
